#!/usr/bin/perl -w

use strict;

#
# Title:		Atheria Markup Language Interpreter/Translator (AML)
# Author: 	Cameron "Mercutio" McKay
# Version:	0.1.0
#
# Purpose:
#
# The Atheria Markup Language (AML) was designed to make it easy for everyone to design Atheria zones.
# Version 1.0.0 is compatible with both CircleMUD zone files and Atheria zone files.  This may not be
# the case in future version, since Atheria is expected to change.  Since AML was written for Atheria
# it will have to stay compatible with Atheria.
#

#
# This chunck of code determines what type of file the arguments are and sends them to their translator. 
#

my ($debug) = 0;

my ($fileType, $fileName);

foreach (@ARGV) {
	$fileName = shift(@ARGV);
	$fileType = (split /\./,$fileName)[1];

	if ($debug >= 3) {
		print "fileName = $fileName\n";
		print "fileType = $fileType\n";
	}

	translate_rml($fileType,$fileName) if $fileType eq 'rml';
#	translate_mml($fileType,$fileName) if $fileType eq 'mml';
#	translate_oml($fileType,$fileName) if $fileType eq 'oml';
#	translate_sml($fileType,$fileName) if $fileType eq 'sml';
#	translate_zml($fileType,$fileName) if $fileType eq 'zml'; 
}


#
# Sub-Routine Section
#

sub translate_rml {
	my ($fileType,$fileName) = @_;
	my (@RML, $line);

	my %DIR = qw(	NORTH 	=>	0
			 	EAST		=>	1	
			 	SOUTH	=>	2
			 	WEST		=>	3
			 	UP		=>	4
			 	DOWN		=>	5
			);

	my (%Tag,%subTag);

	my ($tempHold1, 	$tempHold2);
	my ($zoneNum,		$zoneTag);
	my ($virtNum,		$virtTag);
	my ($dirValue,		$dirTag);

	open(RML,$fileName) || die "can't open $fileName: $!";

	while(<RML>) {
		chomp;
		push (@RML,$_);
	}

	if ($debug >= 3) {
		foreach (@RML) {
			print "$_\n";
		} 	
	}

	foreach $line (@RML) {

	my ($tempHold1, $tempHold2) = '';

#
# If it equals a <word digit> combo then it can only be type ZONE or type VIRTUAL.
# Therefore we only look for those types.
#
# It also checks if either tags are set more than once.  If they are, then it dies
# with an error telling the user to only declare zone once.
#
		if ($line =~ /^<(\w+)\s(\d+)>/) {
			($tempHold1,$tempHold2) = ($1, $2);

			if (!$zoneTag && $tempHold1 =~ /\bZONE\b/i) {
				$zoneNum = $tempHold2;
				$zoneTag++;
				next;
			} elsif ($zoneTag > 1) {
				die "Error: <ZONE> tag set more than once.\n";
			}

			if (!$virtTag && $tempHold1 =~ /\bVIRTUAL\b/i) {
				$virtNum = $tempHold2;
				$virtTag++;
				next;
			} elsif ($virtTag > 1) {
				die "Error: <VIRTUAL> tag must be closed before another is opened.\n";
			}		
#
# If it equals a <word word> combo then it can only be type DIR... but written this way
# for future tags.
#
		} elsif ($line =~ /^<(\w+)\s(\w+)>/) {
			($tempHold1,$tempHold2) = ($1, $2);

			if (!$dirTag && $tempHold1 =~ /\bDIR\b/i) {
				$dirValue = $tempHold2;
				$dirTag++;
				unless ($dirValue =~ /(NORTH|EAST|SOUTH|WEST|UP|DOWN)/ || $dirValue =~ /(0|1|2|3|4|5)/) {
					die "Error: Invald <DIR> value.\n";
				}
			} elsif ($dirTag > 1) {
					die "Error: Opened a new <DIR> tag before closing the old one.";
			}	
#
# Ok, now for more extenisve <word> ones.  First we see if the tag ending is on the same line.
# If it is, it makes this a whole lot easier.
#
		} elsif ($line =~ /<(\w+)>/) {
			die "Error: <VIRTUAL> and <ZONE> tag must be set before any word tags." unless $virtTag && $zoneTag;
			($tempHold1) = $1;

			if ($line =~ /<\/$tempHold1>/) {
				$line =~ s/<$tempHold1>//;
				$line =~ s/<\/$tempHold1>//;
				$line =~ s/^\s+//; $line =~ s/\s+$//; 
				$Tag{$tempHold1} = $line;
			}
		}

	}

#
# This is an information dump... it will be removed shortly.
#

print "Zone: $zoneNum\n";
print "Virtual Number: $zoneNum$virtNum\n";

foreach (keys %Tag) {
	print "$_ = $Tag{$_}\n";
}

}
